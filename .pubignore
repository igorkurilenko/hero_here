# Files and directories to ignore when publishing to pub.dev

# Common files to ignore
*.lock
*.log
*.tmp
.DS_Store

# Other directories to ignore
build/
ios/Flutter/Flutter.framework/
android/app/build/

# The example ships only example.md, which pub.dev shows on the package's
# Example tab. Its apps need photos that would make the package megabytes.
example/*
!example/example.md
assets/
